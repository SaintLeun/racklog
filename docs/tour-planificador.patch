+    const tx = typeof document === 'undefined' ? null : texturaMalla();
+    tx?.repeat.set(largo / 0.05, fondo / 0.05);
+    return new THREE.MeshStandardMaterial({ color: 0xb8bec6, map: tx, alphaMap: null, transparent: !!tx, alphaTest: 0.4, metalness: 0.7, roughness: 0.4, side: THREE.DoubleSide });
+  }
+  if (tipo === 'madera') return new THREE.MeshStandardMaterial({ color: 0xc9a46c, roughness: 0.8, metalness: 0 });
+  return new THREE.MeshStandardMaterial({ color: 0xa9b0b8, metalness: 0.75, roughness: 0.38 });
+}
