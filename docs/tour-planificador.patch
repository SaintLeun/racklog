+function texturaMalla() {
+  const n = 64, c = document.createElement('canvas');
+  c.width = c.height = n;
+  const x = c.getContext('2d');
+  x.clearRect(0, 0, n, n);
+  x.strokeStyle = 'rgba(150,156,164,1)';
+  x.lineWidth = 3;
+  x.strokeRect(1.5, 1.5, n - 3, n - 3);
+  const tx = new THREE.CanvasTexture(c);
+  tx.wrapS = tx.wrapT = THREE.RepeatWrapping;
+  tx.anisotropy = 8;
+  return tx;
+}
+function materialPlano(tipo, largo, fondo) {
