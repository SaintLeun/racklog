+  [-1, 1].forEach((s) => {
+    capsula(0.068, 0.7, m.pantalon, s * 0.095, 0.47, 0);
+    caja(p, 0.11, 0.07, 0.24, 0.03, s * 0.095, 0.035, -0.03, m.zapato);
+  });
