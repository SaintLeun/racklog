+const emit = defineEmits<{ cambio: [c: Record<string, number | null>] }>();
+const m = computed(() => medidasRack(props.rack) as any);
+const fm = (v: number) => (+(+v).toFixed(2)).toLocaleString('es-CL');
+
+function emitir(campo: string, e: Event) {
