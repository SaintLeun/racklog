RewriteEngine On
RewriteBase /

# CORS se gestiona en config/cors.php (lista de origenes permitidos).

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # La API solo devuelve JSON: no debe cargar ni ejecutar nada
    Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

Options -Indexes

# Forzar HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Codigo interno, configuracion y almacenamiento: nunca accesibles por web
RewriteRule ^(config|utils|partials|endpoints|scripts|storage)(/|$) - [F,L]

# Archivos sensibles en cualquier carpeta
<FilesMatch "(?i)(\.(env|log|bak|sql|zip|ini)|^error_log|^token\.php)$">
    Require all denied
</FilesMatch>

# Todo lo demas (incluido /api/send-email y /api/health) pasa por index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
