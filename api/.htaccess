# Enable URL rewriting
RewriteEngine On
RewriteBase /

# CORS se gestiona en config/cors.php (lista de origenes permitidos).
# Las solicitudes OPTIONS tambien pasan por index.php.

# Add security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Disable directory listing for security
Options -Indexes +FollowSymLinks

# Protect sensitive files
<FilesMatch "(?i:^.*\.(env|log|config.php))$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow .json files as they may be needed for API responses
<FilesMatch "\.json$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Route API requests through PHP script
# The key change: Make sure the path is correct and the target file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ /index.php [QSA,L]

# Force https (uncomment if needed)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]